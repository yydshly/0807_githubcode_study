# App
DATABASE_URL=file:./data/aicomic.db
UPLOAD_DIR=./uploads
# Optional maximum size for manually imported videos, in bytes (default: 250 MB)
MAX_IMPORTED_VIDEO_BYTES=262144000

# Codex/local orchestration (never pass model keys on the command line)
COMICCTL_BASE_URL=http://127.0.0.1:3100
COMICCTL_USER_ID=
COMICCTL_PROVIDER_PROFILE=default
ORCHESTRATOR_MAX_CONCURRENCY=3

# Default server-side MiniMax profile
COMIC_PROVIDER_PROFILE_ID=default
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_IMAGE_MODEL=image-01

# Optional external video provider already supported by AIComicBuilder
COMIC_VIDEO_PROTOCOL=
COMIC_VIDEO_BASE_URL=
COMIC_VIDEO_API_KEY=
COMIC_VIDEO_SECRET_KEY=
COMIC_VIDEO_MODEL=

# Optional advanced form: JSON object keyed by profile ID. This overrides a
# convenience profile with the same ID. Keep this value server-side only.
AI_PROVIDER_PROFILES_JSON=
