LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Only required for the real voice Agent:
OPENAI_API_KEY=replace-with-your-own-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# MiniMax Token Plan mode (text input -> MiniMax LLM -> spoken reply):
MINIMAX_API_KEY=replace-with-your-token-plan-key
MINIMAX_LLM_MODEL=MiniMax-M3
MINIMAX_LLM_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE=male-qn-qingse

# Optional microphone input for MiniMax mode (Xiaomi MiMo ASR).
# sk- pay-as-you-go keys use the URL below. For a tp- Token Plan key, replace
# it with the dedicated Base URL displayed on your Xiaomi Token Plan page.
MIMO_API_KEY=replace-with-your-xiaomi-mimo-key
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_LANGUAGE=zh
# Streams recognized text after each complete utterance is uploaded. This is
# faster output, not real-time microphone-frame input. Set false to fall back.
MIMO_ASR_STREAM_OUTPUT=true
AGENT_MIN_SILENCE_SECONDS=0.8
AGENT_MAX_CONCURRENT_JOBS=2
